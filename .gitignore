# Python cache and artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE/editor
.vscode/
.idea/

# Environment variables and secrets
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Trained models and large binaries
models/*.pt
models/*.pth
models/*.ckpt
models/*.pkl

# TFT ablation smoke artefacts (regenerated on Vertex AI; only the
# *_summary.json files are committed for the article tab:tft_ablations)
results/tft_ablations/models/
results/tft_ablations/logs/

# Lightning training runs
lightning_logs/

# Local databases / temporary exports
*.sqlite
*.db

# Vertex AI checkpoints under results/ (regenerable from training/tft_ablations/runner.py)
results/tft_ablations/vertex/*.ckpt

# LaTeX build intermediates (PDFs are committed)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
